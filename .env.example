# --- MinIO (S3-compatible object store; bronze/silver/gold buckets) ---
MINIO_ENDPOINT=http://minio:9000
# Host-side scripts (outside Docker) talk to MinIO on localhost instead:
MINIO_ENDPOINT_HOST=http://localhost:9000
MINIO_ACCESS_KEY=economic_pulse
MINIO_SECRET_KEY=change-me
MINIO_BRONZE_BUCKET=bronze
MINIO_SILVER_BUCKET=silver
MINIO_GOLD_BUCKET=gold

# --- Postgres (Airflow metadata only — no warehouse tables live here) ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=airflow
POSTGRES_USER=airflow
POSTGRES_PASSWORD=change-me

# --- Airflow ---
AIRFLOW_UID=50000
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me
AIRFLOW_ADMIN_EMAIL=alois.wirkes@gmail.com

# --- Banxico SIE API (FX + INPC inflation) ---
# Free token: https://www.banxico.org.mx/SieAPIRest/service/v1/token
# Same token motor-analytics uses — Banxico tokens aren't project-scoped.
# Leave blank to run the pipeline anyway: extract/banxico.py falls back to
# a flagged synthetic series (is_fallback=true) instead of failing.
BANXICO_TOKEN=

# --- INEGI Indicadores API (IGAE, unemployment rate) ---
# Free token (email registration):
# https://www.inegi.org.mx/servicios/api_indicadores.html
# Leave blank to run the pipeline anyway: extract/inegi.py falls back to a
# flagged synthetic series (is_fallback=true) instead of failing.
INEGI_TOKEN=

# --- Tableau Hyper extract (tableau/build_hyper.py) ---
TABLEAU_HYPER_PATH=tableau/economic_pulse_gold.hyper
